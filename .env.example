# Local development only. Render reads these values from its Environment settings.
NODE_ENV=development
PROVIDER_MODE=demo
PORT=4000
API_PORT=4000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000

# Required for live translation and speech recognition on the server.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
TRANSLATION_MODEL=gpt-4o-2024-08-06
STT_MODEL=scribe_v2
TTS_MODEL=eleven_v4

# Optional: bundled FFmpeg/FFprobe binaries are used when paths are blank.
FFMPEG_PATH=
FFPROBE_PATH=

# Needed to create the first administrator account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional local persistence/payment configuration.
DATA_DIR=
DATABASE_PATH=
PAYMENT_INSTRUCTIONS=
