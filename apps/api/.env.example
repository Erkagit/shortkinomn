# demo: no API requests; fixed example transcript and tone audio, NOT real dubbing
PROVIDER_MODE=demo
PORT=4000
WEB_ORIGIN=http://localhost:3000
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
TRANSLATION_MODEL=gpt-4o-2024-08-06
STT_MODEL=scribe_v2
TTS_MODEL=eleven_v4
# Optional absolute executable paths when FFmpeg is not on PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Streaming platform. Set a unique password (10+ characters) before first startup.
# Bootstrap creates a new ADMIN only; existing users are never silently promoted.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Manual payment instructions: bank, account holder, account, MNT currency.
# Empty means checkout is disabled. No payment is automatically approved.
PAYMENT_INSTRUCTIONS=
# Optional: DATA_DIR, DATABASE_PATH. Default database: data/platform.sqlite
# Production: NODE_ENV=production, WEB_ORIGIN=https://your-domain
# Next.js: API_INTERNAL_URL=http://127.0.0.1:4000 (set before build and start)
